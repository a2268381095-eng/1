{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "小恶魔文书",
  "mainBinaryName": "xiaoemo-wenshu",
  "version": "0.1.0",
  "identifier": "com.xiaoemo.wenshu",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "node build.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "小恶魔文书",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "shortDescription": "本地中文写作软件",
    "windows": {
      "nsis": { "languages": ["SimpChinese"], "displayLanguageSelector": false, "installMode": "currentUser" }
    }
  }
}
