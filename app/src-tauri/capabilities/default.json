{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "主窗口的权限：可以访问任意 https 地址（调用 AI 接口），作者自己填的自定义接口也可能是 http",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "http:default",
      "allow": [{ "url": "https://*" }, { "url": "http://*" }]
    }
  ]
}
